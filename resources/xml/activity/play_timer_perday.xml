<?xml version="1.0" encoding="UTF-8"?>

<!-- Per-day play-time limits: edits are staged in `pending[]` and written
     together by "Save". B leaves (asking first when something is unsaved). -->

<brls:AppletFrame
    iconInterpolation="linear">

    <brls:ScrollingFrame
        title="@i18n/nx_pctl/play_timer/perday/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <PtStateHeader id="pt_state_header"/>

            <brls:Header title="@i18n/nx_pctl/play_timer/perday/section_days" marginBottom="8"/>

            <brls:DetailCell id="pt_d1"/>
            <brls:DetailCell id="pt_d2"/>
            <brls:DetailCell id="pt_d3"/>
            <brls:DetailCell id="pt_d4"/>
            <brls:DetailCell id="pt_d5"/>
            <brls:DetailCell id="pt_d6"/>
            <brls:DetailCell id="pt_d0"/>

            <brls:Header title="@i18n/nx_pctl/play_timer/perday/section_presets" marginTop="16" marginBottom="8"/>

            <brls:DetailCell id="pt_weekdays" title="@i18n/nx_pctl/play_timer/perday/weekdays"/>
            <brls:DetailCell id="pt_weekend"  title="@i18n/nx_pctl/play_timer/perday/weekend"/>
            <brls:DetailCell id="pt_copy_today"/>
            <brls:DetailCell id="pt_revert"   title="@i18n/nx_pctl/play_timer/perday/revert"/>

            <brls:Header title="@i18n/nx_pctl/play_timer/perday/section_save" marginTop="16" marginBottom="8"/>

            <brls:DetailCell id="pt_save" title="@i18n/nx_pctl/play_timer/perday/save"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:AppletFrame>
