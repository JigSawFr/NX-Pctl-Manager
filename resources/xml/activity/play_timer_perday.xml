<?xml version="1.0" encoding="UTF-8"?>

<!-- Per-day play-time limits: the week chart is the editor (←/→ pick a day,
     A changes it); edits are staged in `pending[]` and written together by
     "Save" (also +). B leaves (asking first when something is unsaved). -->

<brls:AppletFrame
    iconInterpolation="linear">

    <ScrollView
        title="@i18n/playguard/play_timer/perday/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <PtStateHeader id="pt_state_header"/>

            <brls:Header title="@i18n/playguard/play_timer/perday/section_days" marginBottom="8"/>

            <PtWeekView id="pt_week" width="auto" height="auto" marginTop="8" marginBottom="8"/>
            <brls:Label id="pt_unavailable" text="@i18n/playguard/play_timer/perday/unavailable" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/warn"/>

            <brls:Header title="@i18n/playguard/play_timer/perday/section_presets" marginTop="16" marginBottom="8"/>

            <brls:DetailCell id="pt_weekdays" title="@i18n/playguard/play_timer/perday/weekdays"/>
            <brls:DetailCell id="pt_weekend"  title="@i18n/playguard/play_timer/perday/weekend"/>
            <brls:DetailCell id="pt_copy_today"/>
            <brls:DetailCell id="pt_revert"   title="@i18n/playguard/play_timer/perday/revert"/>

            <brls:Header title="@i18n/playguard/play_timer/perday/section_save" marginTop="16" marginBottom="8"/>

            <brls:DetailCell id="pt_save" title="@i18n/playguard/play_timer/perday/save"/>

        </brls:Box>

    </ScrollView>

</brls:AppletFrame>
