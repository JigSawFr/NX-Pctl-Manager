<?xml version="1.0" encoding="UTF-8"?>

<!-- The change history, newest first: A on a change shows it and offers to
     put the previous value back. The list is built by
     source/activity/history_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <brls:ScrollingFrame
        title="@i18n/playguard/history/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            id="hi_root"
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <brls:Label id="hi_note" text="" fontSize="20" marginBottom="16" textColor="@theme/brand/note"/>
            <brls:Header title="@i18n/playguard/history/section" marginBottom="8"/>
            <brls:Box id="hi_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:Label id="hi_empty" text="@i18n/playguard/history/none" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:AppletFrame>
