<?xml version="1.0" encoding="UTF-8"?>

<!-- Recovery screen, shown at start-up when the playguard-rescue sysmodule
     left a report (a parent used the RESCUE file after forgetting the PIN).
     It says what happened, then offers to show or reset the PIN or delete
     every parental control, before continuing to PlayGuard. Filled by
     rescue_activity.cpp; it bypasses PlayGuard's own "ask the PIN to open". -->

<brls:AppletFrame
    iconInterpolation="linear">

    <brls:ScrollingFrame
        title="@i18n/playguard/rescue/title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <brls:Label id="rc_outcome" text="" fontSize="26" marginBottom="6"/>
            <brls:Label id="rc_note" text="" fontSize="20" marginBottom="20" textColor="@theme/brand/note"/>

            <brls:Header id="rc_actions_header" title="@i18n/playguard/rescue/section_actions" marginBottom="8"/>
            <brls:DetailCell id="rc_show_pin" title="@i18n/playguard/security/show_pin"/>
            <brls:DetailCell id="rc_reset_pin" title="@i18n/playguard/rescue/reset_pin"/>
            <brls:DetailCell id="rc_delete" title="@i18n/playguard/security/delete"/>

            <brls:Header title="@i18n/playguard/rescue/section_done" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="rc_continue" title="@i18n/playguard/rescue/continue"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:AppletFrame>
