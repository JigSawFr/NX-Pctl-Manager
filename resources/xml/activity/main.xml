<?xml version="1.0" encoding="UTF-8"?>

<!-- Root screen: a sidebar of tabs (Horizon "System Settings" style). Each tab
     is a custom view registered in main.cpp and implemented in source/tab/. -->

<brls:AppletFrame
    iconInterpolation="linear"
    footerHidden="false">

    <brls:TabFrame
        id="main_tabs"
        title="@i18n/playguard/title"
        icon="@res/img/app_icon.jpg">

        <brls:Tab label="@i18n/playguard/tabs/dashboard">
            <DashboardTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="@i18n/playguard/tabs/play_timer">
            <PlayTimerTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/activity">
            <ActivityTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/restrictions">
            <RestrictionsTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/clock">
            <ClockTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="@i18n/playguard/tabs/security">
            <SecurityTab/>
        </brls:Tab>

        <brls:Separator/>

        <brls:Tab label="@i18n/playguard/tabs/preferences">
            <PreferencesTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/tools">
            <ToolsTab/>
        </brls:Tab>

        <brls:Tab label="@i18n/playguard/tabs/about">
            <AboutTab/>
        </brls:Tab>

    </brls:TabFrame>

</brls:AppletFrame>
