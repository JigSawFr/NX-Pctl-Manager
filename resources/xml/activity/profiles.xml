<?xml version="1.0" encoding="UTF-8"?>

<!-- Saved play-time profiles: A on one offers apply / edit / rename / delete,
     Y deletes it; below, save the current limits or make a new profile. The
     list is rebuilt by source/activity/profiles_activity.cpp. -->

<brls:AppletFrame
    iconInterpolation="linear">

    <brls:ScrollingFrame
        title="@i18n/playguard/play_timer/profiles_title"
        icon="@res/img/app_icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <brls:Header title="@i18n/playguard/play_timer/profiles_section_saved" marginBottom="8"/>
            <brls:Box id="pf_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:Label id="pf_empty" text="@i18n/playguard/play_timer/profile_none" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Label id="pf_hint" text="@i18n/playguard/play_timer/profiles_hint" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Header title="@i18n/playguard/play_timer/profiles_section_new" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="pf_save" title="@i18n/playguard/play_timer/profile_save"/>
            <brls:DetailCell id="pf_new" title="@i18n/playguard/play_timer/profile_new"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:AppletFrame>
