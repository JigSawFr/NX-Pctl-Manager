<?xml version="1.0" encoding="UTF-8"?>

<!-- First steps, history, settings backup, diagnostics, the console and (once enabled
     by seven presses on About › Version) the developer tools. The
     preferences and About have their own tabs (preferences.xml, about.xml). -->

<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Header title="@i18n/playguard/tools/section_start" marginBottom="8"/>
            <brls:DetailCell id="tl_first_steps" title="@i18n/playguard/onboarding/open"/>
            <brls:Header title="@i18n/playguard/tools/section_history" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="tl_history" title="@i18n/playguard/history/open"/>
            <brls:Header title="@i18n/playguard/tools/section_backup" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="tl_backup_save" title="@i18n/playguard/tools/backup_save"/>
            <brls:DetailCell id="tl_backup_restore" title="@i18n/playguard/tools/backup_restore"/>
            <brls:DetailCell id="tl_backup_keep" title="@i18n/playguard/tools/backup_keep"/>
            <brls:Label id="tl_backup_note" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Header title="@i18n/playguard/tools/section_diag" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="tl_export" title="@i18n/playguard/tools/export"/>
            <brls:Label id="tl_export_note" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Header title="@i18n/playguard/tools/section_console" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="tl_fw" focusable="false" title="@i18n/playguard/tools/firmware"/>
            <brls:DetailCell id="tl_ams" focusable="false" title="@i18n/playguard/tools/atmosphere"/>
            <brls:DetailCell id="tl_compat" title="@i18n/playguard/tools/compat"/>
            <brls:DetailCell id="tl_storage" focusable="false" title="@i18n/playguard/tools/storage"/>
            <brls:DetailCell id="tl_blank" focusable="false" title="@i18n/playguard/tools/blank"/>
            <brls:DetailCell id="tl_serial" title="@i18n/playguard/tools/serial"/>
            <brls:Label id="tl_serial_note" text="@i18n/playguard/tools/serial_note_emummc" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/warn"/>
            <brls:DetailCell id="tl_patches" title="@i18n/playguard/tools/patches"/>
            <brls:Label id="tl_patches_note" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Header id="tl_dev_header" title="@i18n/playguard/dev/section" marginTop="24" marginBottom="8"/>
            <brls:BooleanCell id="tl_dev_mode"/>
            <brls:BooleanCell id="tl_dev_read_only"/>
            <brls:DetailCell id="tl_dev_report" title="@i18n/playguard/dev/report"/>
            <brls:DetailCell id="tl_dev_pt_block" title="@i18n/playguard/dev/pt_block"/>
            <brls:DetailCell id="tl_dev_gate" title="@i18n/playguard/dev/gate"/>
            <brls:DetailCell id="tl_dev_forget" title="@i18n/playguard/dev/forget"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
