<?xml version="1.0" encoding="UTF-8"?>

<!-- Companion phone app: link state and unlink. -->

<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Label id="tab_ro_note" text="@i18n/playguard/common/read_only_note" fontSize="18" marginBottom="16" textColor="@theme/brand/warn"/>
            <brls:Header title="@i18n/playguard/pairing/section" marginBottom="8"/>
            <brls:DetailCell id="pr_active" title="@i18n/playguard/pairing/active"/>
            <brls:DetailCell id="pr_updated" title="@i18n/playguard/pairing/updated"/>
            <brls:DetailCell id="pr_unlink" title="@i18n/playguard/pairing/unlink"/>
            <brls:Label id="pr_note" text="@i18n/playguard/pairing/note" fontSize="18" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
