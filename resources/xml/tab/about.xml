<?xml version="1.0" encoding="UTF-8"?>

<!-- About: the version (seven presses turn the developer tools on, at the end
     of Tools), the app's details and credits, then what changed in the latest
     releases (the bundled CHANGELOG.md, filled in by AboutTab). -->

<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Header title="@i18n/playguard/tools/section_about" marginBottom="8"/>
            <brls:DetailCell id="ab_version" title="@i18n/playguard/tools/version"/>
            <brls:DetailCell id="ab_mode" focusable="false" title="@i18n/playguard/tools/mode"/>
            <brls:DetailCell id="ab_data" focusable="false" title="@i18n/playguard/tools/data"/>
            <brls:DetailCell id="ab_license" focusable="false" title="@i18n/playguard/tools/license"/>
            <brls:DetailCell id="ab_source" focusable="false" title="@i18n/playguard/tools/source"/>
            <brls:Label id="ab_credits" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Header title="@i18n/playguard/about/section_changelog" marginTop="24" marginBottom="8"/>
            <brls:Label id="ab_changelog_note" text="" fontSize="20" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Box id="ab_changelog" width="auto" height="auto" axis="column" alignItems="stretch"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
