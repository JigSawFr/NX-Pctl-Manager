<?xml version="1.0" encoding="UTF-8"?>

<!-- Activity: play time per game (today, last 7 days, all time), read from the
     console's play data for every account, its summary over the chosen period,
     the games to rediscover, and its export to the SD card. The game cells
     (icon, name, time) are added in code; A on one opens its screen
     (activity/game.xml). -->

<brls:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Header title="@i18n/playguard/activity/section_totals" marginBottom="8"/>
            <brls:DetailCell id="ac_account" title="@i18n/playguard/activity/account"/>
            <PlayDaysView id="ac_days" width="auto" height="auto" marginTop="8" marginBottom="16"/>
            <brls:DetailCell id="ac_today" focusable="false" title="@i18n/playguard/activity/today"/>
            <brls:DetailCell id="ac_week" focusable="false" title="@i18n/playguard/activity/week"/>
            <brls:DetailCell id="ac_total" focusable="false" title="@i18n/playguard/activity/all_time"/>
            <brls:Header title="@i18n/playguard/activity/section_summary" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="ac_period" title="@i18n/playguard/activity/period"/>
            <brls:DetailCell id="ac_per_day" focusable="false" title="@i18n/playguard/activity/summary/per_day"/>
            <brls:DetailCell id="ac_top" focusable="false" title="@i18n/playguard/activity/summary/top"/>
            <brls:DetailCell id="ac_days_played" focusable="false" title="@i18n/playguard/activity/summary/days_played"/>
            <brls:DetailCell id="ac_busiest" focusable="false" title="@i18n/playguard/activity/summary/busiest"/>
            <brls:DetailCell id="ac_session" focusable="false" title="@i18n/playguard/activity/summary/session"/>
            <brls:Box id="ac_rediscover" width="auto" height="auto" axis="column" alignItems="stretch">
                <brls:Header title="@i18n/playguard/activity/section_rediscover" marginTop="24" marginBottom="8"/>
                <brls:Box id="ac_rediscover_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
                <brls:Label text="@i18n/playguard/activity/rediscover_note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            </brls:Box>
            <brls:Header title="@i18n/playguard/activity/section_games" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="ac_export" title="@i18n/playguard/activity/export"/>
            <brls:Box id="ac_progress" axis="row" alignItems="center" marginTop="10" marginBottom="6" marginLeft="16" marginRight="16">
                <brls:ProgressSpinner width="30" height="30" marginRight="14"/>
                <brls:Label text="@i18n/playguard/activity/loading" fontSize="20" grow="1.0" textColor="@theme/brand/note"/>
            </brls:Box>
            <brls:Box id="ac_list" width="auto" height="auto" axis="column" alignItems="stretch"/>
            <brls:Label id="ac_status" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Label id="ac_note" text="@i18n/playguard/activity/note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>

        </brls:Box>

    </ScrollView>

</brls:Box>
