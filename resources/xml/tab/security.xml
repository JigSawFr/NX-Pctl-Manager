<?xml version="1.0" encoding="UTF-8"?>

<!-- PIN, temporary unlock / relock, delete everything. -->

<brls:Box
    width="auto"
    height="auto">

    <ScrollView
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Label id="tab_ro_note" text="@i18n/playguard/common/read_only_note" fontSize="20" marginBottom="16" textColor="@theme/brand/warn"/>
            <brls:Header title="@i18n/playguard/security/section_status" marginBottom="8"/>
            <brls:DetailCell id="sc_pin" focusable="false" title="@i18n/playguard/security/pin"/>
            <brls:DetailCell id="sc_restrictions" focusable="false" title="@i18n/playguard/security/restrictions"/>
            <brls:DetailCell id="sc_temp" focusable="false" title="@i18n/playguard/security/temporary"/>
            <brls:Header id="sc_actions_header" title="@i18n/playguard/security/section_actions" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="sc_set_pin" title="@i18n/playguard/security/set_pin"/>
            <brls:DetailCell id="sc_pin_lock" title="@i18n/playguard/pin_lock/title"/>
            <brls:DetailCell id="sc_show_pin" title="@i18n/playguard/security/show_pin"/>
            <brls:DetailCell id="sc_unlock" title="@i18n/playguard/security/unlock"/>
            <brls:DetailCell id="sc_relock" title="@i18n/playguard/security/relock"/>
            <brls:Label id="sc_pin_lock_note" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Header id="sc_lock_header" title="@i18n/playguard/console_lock/section" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="sc_console_lock" title="@i18n/playguard/console_lock/title"/>
            <brls:Label id="sc_console_lock_note" text="" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Header title="@i18n/playguard/pairing/section" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="pr_active" focusable="false" title="@i18n/playguard/pairing/active"/>
            <brls:DetailCell id="pr_updated" focusable="false" title="@i18n/playguard/pairing/updated"/>
            <brls:DetailCell id="pr_unlink" title="@i18n/playguard/pairing/unlink"/>
            <brls:Label id="pr_note" text="@i18n/playguard/pairing/note" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>
            <brls:Header id="sc_danger_header" title="@i18n/playguard/security/section_danger" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="sc_delete" title="@i18n/playguard/security/delete"/>
            <brls:Header title="@i18n/playguard/modules/locked_out" marginTop="24" marginBottom="8"/>
            <brls:DetailCell id="sc_rescue" title="@i18n/playguard/modules/rescue/title"/>
            <brls:Label id="sc_rescue_note" text="@i18n/playguard/modules/rescue/about" fontSize="20" marginTop="10" marginBottom="6" textColor="@theme/brand/note"/>

        </brls:Box>

    </ScrollView>

</brls:Box>
